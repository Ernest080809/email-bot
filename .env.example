# ── Vinted Designer Sniper ─────────────────────────────────────────────────────

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Vinted country domain to monitor
# Options: fr de uk es it pl nl be pt cz lt lv at se fi ro hu sk gr
VINTED_COUNTRY=fr

# How often to check each watchlist (seconds, minimum 15)
POLL_INTERVAL=30

# Path to save watchlist configuration (default: config.json in project root)
# CONFIG_PATH=config.json

# ── Legacy / other features ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
API_KEYS=store1_key_here,store2_key_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
