# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Personal Dashboard Telegram Bot ───────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → follow prompts
# 2. Copy the token it gives you and paste it here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Widget API keys (one per client / Shopify store you sell to) ──────────────
# Generate a random key for each store owner, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Add each key separated by a comma.
# Leave empty to run in open/dev mode (no key required).
API_KEYS=store1_key_here,store2_key_here

# ── Shopify webhook secret (auto-refresh when new products are added) ─────────
# In each client's Shopify: Settings → Notifications → Webhooks → Create webhook
#   Event: Product creation  |  URL: https://YOUR-SERVER.com/api/shop/webhook/shopify
#   Event: Product update    |  URL: https://YOUR-SERVER.com/api/shop/webhook/shopify
# Shopify shows a "Signing secret" — paste it here.
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# ── Optional: enables the "try it on" photo feature ───────────────────────────
# Sign up at https://replicate.com and get your token.
REPLICATE_API_TOKEN=your_replicate_api_token_here
