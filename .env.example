# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Widget API keys (one per client / Shopify store you sell to) ──────────────
# Generate a random key for each store owner, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Add each key separated by a comma.
# Leave empty to run in open/dev mode (no key required).
API_KEYS=store1_key_here,store2_key_here

# ── Optional: enables the "try it on" photo feature ───────────────────────────
# Sign up at https://replicate.com and get your token.
REPLICATE_API_TOKEN=your_replicate_api_token_here
